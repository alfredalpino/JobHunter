# Optional web job sources (public APIs / official RSS only — never LinkedIn)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Comma-separated Adzuna country codes when keys are set (e.g. us,gb,ae,ca).
# If empty, JobHunter picks from the active region pack (remote expands to a few markets).
ADZUNA_COUNTRIES=
JOOBLE_API_KEY=
# Optional Findwork.dev API (Token auth) — https://findwork.dev/developers/
FINDWORK_API_KEY=
USAJOBS_USER_AGENT=
USAJOBS_API_KEY=

# Shared job index (Postgres / Neon / Vercel Postgres). Optional —
# without DATABASE_URL, hunt falls back to live scrape.
DATABASE_URL=

# Protects POST /api/cron/ingest and POST /api/admin/ingest
CRON_SECRET=

# Optional AI polish / shortlist re-rank (checkbox in UI + BYOK)
GEMINI_API_KEY=

# Optional Python deep-hunt sidecar (cli-local branch)
# DEEP_HUNT_URL=http://127.0.0.1:8765
